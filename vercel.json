{
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/",
      "/project/:path*",
      "/profile/:path*",
      "/u/:path*",
      "/explore/:path*",
      "/leaderboard",
      "/:accountName",
      "/:accountName/projects/:slugId",
      "/:accountName/lists/:listId"
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "compute-pressure=*"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.lrcstudio.app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
